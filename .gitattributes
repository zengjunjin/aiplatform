# 统一行尾为 LF，避免 Windows(CRLF) 与 Linux(LF) 差异导致 CI 失败
# 核心问题：core.autocrlf=true 导致本地 ruff/format 看到的是 CRLF，
# 而 CI Linux 看到的是 LF，可能产生不同的格式化结果
* text=auto eol=lf

# 明确指定文本文件使用 LF
*.py text eol=lf
*.pyi text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.lock text eol=lf
*.svg text eol=lf
*.xml text eol=lf

# Windows 专用脚本保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.node binary
*.wasm binary
