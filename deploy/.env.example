# ============================================
# RAG 知识库平台 - Docker 部署环境变量
# ============================================
# 复制此文件为 .env 并修改相应配置

# ---- PostgreSQL ----
POSTGRES_DB=rag_platform
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Qdrant ----
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- Ollama ----
OLLAMA_PORT=11434

# ---- 后端 ----
BACKEND_PORT=8000

# ---- Nginx ----
NGINX_HTTP_PORT=80

# ---- JWT 安全 ----
JWT_SECRET=please_change_this_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 模型配置 ----
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- 文档分块 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ---- 文件上传 ----
MAX_FILE_SIZE_MB=50

# ---- CORS ----
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# ---- 日志 ----
LOG_LEVEL=info