# ============================================
# RAG 知识库平台 - Docker 部署环境变量
# ============================================
# 复制此文件为 .env 并修改相应配置
#
# !!! 重要安全提示 !!!
# 1. POSTGRES_PASSWORD 与 JWT_SECRET 必须在部署前修改为强随机值
# 2. 后端启动时若检测到弱密钥/弱密码，在非 DEBUG 模式下会直接拒绝启动
# 3. 建议使用：openssl rand -base64 48 生成强随机字符串
# 4. 不要将填好真实密钥的 .env 文件提交到版本控制系统

# ---- PostgreSQL ----
# 安全：必须修改为强随机密码（至少 16 字符，包含大小写字母/数字/符号）
POSTGRES_DB=rag_platform
POSTGRES_USER=rag
# 必填，请勿使用 rag_password / postgres / password 等弱值
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Qdrant ----
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- Ollama ----
OLLAMA_PORT=11434

# ---- 后端 ----
BACKEND_PORT=8000

# ---- 初始管理员账户 ----
# 初始化数据库（init_db.py）时创建的 admin 用户密码
# 未设置时将自动生成强随机密码，并通过 logger.warning 输出（仅日志，不输出到 stdout）
# 生产环境建议显式设置强随机值，生成示例：openssl rand -base64 24
INITIAL_ADMIN_PASSWORD=

# ---- Nginx ----
NGINX_HTTP_PORT=80

# ---- JWT 安全 ----
# 安全：必须修改为强随机字符串（至少 32 字符）
# 生成示例：openssl rand -base64 48
# 禁用值：please_change_this_to_a_long_random_string_at_least_32_chars / change_me / secret 等
JWT_SECRET=
JWT_ALGORITHM=HS256
# Access token 过期时间（分钟）；与 backend/.env.example 保持一致
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 模型配置 ----
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- LLM 提供商配置（JSON 格式）----
# P0-C1: Docker 部署必须使用服务名 ollama（docker-compose 内部网络），而非 localhost
# 主模型 qwen2.5:7b（需 GPU）+ fallback 模型 qwen2.5:1.5b（CPU 可用）
# 本地开发（poetry run uvicorn）请改为 http://localhost:11434/v1
LLM_PROVIDERS_JSON=[{"name":"ollama","type":"ollama","api_base":"http://ollama:11434/v1","model":"qwen2.5:7b","priority":99,"max_retries":1,"timeout":300,"fallback_to":null,"is_free":true},{"name":"ollama-fallback","type":"ollama","api_base":"http://ollama:11434/v1","model":"qwen2.5:1.5b","priority":100,"max_retries":1,"timeout":300,"fallback_to":null,"is_free":true}]

# Ollama 服务地址（后端直连，用于健康检查与模型拉取）
# Docker 部署使用服务名；本地开发使用 localhost
OLLAMA_HOST=http://ollama:11434

# ---- 嵌入向量缓存 ----
# 启用后可显著减少对 Ollama 的重复嵌入请求（Task 7 使用）
EMBEDDING_CACHE_ENABLED=true
# 缓存 TTL（秒），默认 7 天 = 604800
EMBEDDING_CACHE_TTL=604800

# ---- 文档分块 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ---- 文件上传 ----
# 生产环境允许更大文件（50MB）；本地开发默认 20MB（见 backend/.env.example）
MAX_FILE_SIZE_MB=50

# ---- CORS ----
# 包含 Tauri 桌面端所需 origin（tauri://localhost, https://tauri.localhost, http://tauri.localhost, http://localhost:1420）
# 以及 Web 端 origin（http://localhost, http://localhost:5173）
CORS_ORIGINS=tauri://localhost,https://tauri.localhost,http://tauri.localhost,http://localhost:1420,http://localhost,http://localhost:5173

# ---- 日志 ----
LOG_LEVEL=info
# Task 4/5: 启用 loguru JSON 结构化输出，包含 timestamp/level/request_id/
# trace_id/span_id/message 等字段，便于 Loki/ELK 等日志采集系统解析与关联 trace
# docker-compose 默认启用；本地开发若需可读彩色日志可设为 false
LOG_JSON=true

# ---- 可观测性（OpenTelemetry + Jaeger + Grafana）----
# Task 3: OpenTelemetry 追踪导出端点（OTLP HTTP）
# docker-compose 内部网络访问 jaeger:4318；本地直连改为 http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Task 3: 后端服务名（出现在 Jaeger Service 列表中）
# 注意：docker-compose.yml 中 backend=rag-platform-backend，celery=rag-platform-celery
# 此处仅作为本地启动时的默认值；docker-compose 会显式覆盖
OTEL_SERVICE_NAME=rag-platform-backend
# 采样率（ParentBased(TraceIdRatioBased(ratio))）
# 1.0=全采样（开发推荐），0.1=10%采样（生产推荐）
OTEL_TRACES_SAMPLER_ARG=0.1
# Jaeger UI 端口（浏览器访问 http://localhost:16686 查看 trace）
JAEGER_UI_PORT=16686
# Jaeger OTLP HTTP 接收端口（backend/celery 通过此端口推送 trace）
JAEGER_OTLP_HTTP_PORT=4318
# Jaeger OTLP gRPC 接收端口（备用，HTTP 优先）
JAEGER_OTLP_GRPC_PORT=4317
# Prometheus 端口（抓取 backend /internal/metrics 端点）
PROMETHEUS_PORT=9090
# Task 7: Grafana Web UI 端口
GRAFANA_PORT=3000
# Task 7: Grafana admin 账户密码
# 必填：必须修改为强随机密码（至少 12 字符），不可使用 admin/弱密码
# 生成示例：openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# ---- WebSocket ----
# 逗号分隔的允许 Origin 白名单
# 包含 Tauri 桌面端 origin（与 backend/.env.example 保持一致，遵守 ADR-009 Tauri 约束）
WEBSOCKET_ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost,http://tauri.localhost,http://localhost:1420,http://localhost:5173
# 单用户最大并发连接数
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
# 单用户消息频率限制（每分钟消息数）
WEBSOCKET_RATE_LIMIT_PER_MINUTE=10

# ---- SSE 流式接口 ----
# 单用户最大并发 SSE 连接数
SSE_MAX_CONCURRENT=3

# ---- 限流 ----
RATE_LIMIT_ENABLED=true

# ---- Metrics ----
# Prometheus 抓取端点 (/internal/metrics) 的 Bearer token
# 生成: openssl rand -hex 32
METRICS_TOKEN=