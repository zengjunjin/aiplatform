# ============================================
# RAG 知识库平台 - 后端环境变量
# 复制为 .env 并按需修改
# ============================================

# ---- 应用 ----
APP_NAME=RAG Knowledge Base Platform
DEBUG=false
ENABLE_DOCS=false
LOG_LEVEL=info
# 是否启用 loguru JSON sink（结构化日志）
# true 时日志以 JSON 格式输出，便于 ELK/Loki 等日志采集系统解析
# false 时保持人类可读格式
LOG_JSON=true

# ---- 数据库 (PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
# 必填，请勿使用弱值（rag_password/postgres/password 等）；生产环境请设置强随机密码
POSTGRES_PASSWORD=
POSTGRES_DB=rag_platform
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
# 连接池获取超时（秒），避免请求无限等待连接
DB_POOL_TIMEOUT=10

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Qdrant 向量数据库 ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- JWT 安全 ----
# 生产环境必须替换为至少 32 字符的强随机字符串
JWT_SECRET=please_replace_with_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=rag-platform
JWT_AUDIENCE=rag-client

# ---- 密码策略 ----
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# ---- 初始管理员账户 ----
# 初始化数据库（init_db.py）时创建的 admin 用户密码
# 未设置时将自动生成强随机密码，并通过 logger.warning 输出（仅日志，不输出到 stdout）
# 生产环境建议显式设置强随机值，生成示例：openssl rand -base64 24
INITIAL_ADMIN_PASSWORD=

# ---- Ollama ----
OLLAMA_HOST=http://localhost:11434

# ---- LLM 配置 ----
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_ROUTING_STRATEGY=round_robin
LLM_FALLBACK_ENABLED=true
LLM_HEALTH_CHECK_INTERVAL=30
# 健康检查：连续失败多少次后标记 provider 为 unhealthy
LLM_HEALTH_CHECK_MAX_FAILURES=3
# 健康检查：单个 provider 检查超时（秒）
LLM_HEALTH_CHECK_TIMEOUT=10
# JSON 数组，配置多个 LLM 提供商以支持 fallback
LLM_PROVIDERS_JSON=[{"name":"ollama","type":"ollama","api_base":"http://localhost:11434/v1","model":"qwen2.5:7b","priority":99,"max_retries":1,"timeout":300,"fallback_to":null,"is_free":true}]

# ---- Embedding 配置 ----
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_CONCURRENCY=4
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=604800

# ---- Reranker ----
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- 文档分块与检索 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
# BM25/向量融合 alpha 权重（1.0 纯向量，0.0 纯 BM25，0.5 等权加权）
RETRIEVAL_ALPHA=0.5
# 检索结果 score 阈值过滤（低于此分数的 chunks 不进入 prompt）
RETRIEVAL_SCORE_THRESHOLD=0.3
# BM25 检索 score 阈值过滤（低于此分数的 chunks 不进入 RRF 融合）
BM25_SCORE_THRESHOLD=0.01
# 查询扩展开关：开启后检索前生成多个查询变体并行检索（默认关闭以保持现有行为）
QUERY_EXPANSION_ENABLED=false
# 上下文窗口 token 预算：历史对话保留预算
HISTORY_TOKEN_BUDGET=6000
# 上下文窗口 token 预算：检索结果保留预算
RETRIEVAL_TOKEN_BUDGET=4000

# ---- 聊天历史 ----
# 历史消息拉取条数
CHAT_HISTORY_LIMIT=20
# 摘要压缩后保留的最近消息条数
CHAT_HISTORY_KEEP_RECENT=4
# Redis 聊天上下文缓存 TTL（秒，86400 = 1 天）
CHAT_HISTORY_TTL_SECONDS=86400
# Redis 聊天上下文缓存保留条数
CHAT_HISTORY_REDIS_KEEP_RECENT=20

# ---- 文件存储 ----
MAX_FILE_SIZE_MB=20
MAX_DOCUMENTS_PER_KB=100

# ---- BM25/RRF 配置 ----
BM25_CACHE_MAX_KB=8
BM25_CACHE_MAX_CHUNKS_PER_KB=50000
# retriever singleflight 锁 LRU 上限（防 KB 增多后锁字典无界增长导致内存泄漏）
RETRIEVER_LOCKS_MAX_SIZE=100
# RRF（Reciprocal Rank Fusion）融合参数 k
RRF_K=60
# BM25 索引在 Redis 中的 TTL（秒，86400 = 1 天）
BM25_INDEX_TTL=86400

# ---- CORS ----
# 逗号分隔的来源列表
CORS_ORIGINS=tauri://localhost,https://tauri.localhost,http://tauri.localhost,http://localhost:1420,http://localhost:5173

# ---- WebSocket ----
# 逗号分隔的允许 Origin 白名单
WEBSOCKET_ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost,http://tauri.localhost,http://localhost:1420,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
WEBSOCKET_RECV_TIMEOUT=30
WEBSOCKET_RATE_LIMIT_PER_MINUTE=10
# 频率限制窗口（秒）
WEBSOCKET_RATE_LIMIT_WINDOW=60
# 进程内频率计数器 LRU 上限
WEBSOCKET_INPROC_RATE_LRU_MAX=10000
# 心跳间隔（秒）
WEBSOCKET_HEARTBEAT_INTERVAL=30
# 心跳 pong 等待超时（秒）
WEBSOCKET_HEARTBEAT_PONG_TIMEOUT=10
# 心跳连续未响应次数上限（超过则断开连接）
WEBSOCKET_HEARTBEAT_MAX_MISSED=3
# 离线消息 TTL（秒，604800 = 7 天）
WEBSOCKET_OFFLINE_MESSAGE_TTL=604800

# ---- SSE 流式 ----
# 单用户最大并发 SSE 连接数（防止滥用）
SSE_MAX_CONCURRENT=3
# SSE 计数器 Redis key 的 TTL（秒，600 = 10 分钟过期保护，防止计数器泄漏）
SSE_COUNT_TTL=600
# 流式生成时每 N 个 token 检查一次取消标志（平衡 RTT 与响应灵敏度）
CANCEL_CHECK_INTERVAL=16

# ---- 评估 ----
# 评估管线并发度
EVAL_CONCURRENCY=8
# 评估增量提交批次大小（每 N 个问题提交一次，避免全部结果丢失）
EVAL_INCREMENTAL_COMMIT_BATCH=10
# 文档解析任务重试次数（解析失败可重试，避免瞬时抖动导致永久失败）
TASK_MAX_RETRIES_PARSING=3
# 评估任务重试次数（评估较重，重试次数较少避免浪费资源）
TASK_MAX_RETRIES_EVALUATION=2

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- 限流 ----
RATE_LIMIT_ENABLED=true

# ---- Metrics ----
# Metrics endpoint token for Prometheus scraping
# Generate with: openssl rand -hex 32
METRICS_TOKEN=

# ---- 其他配置 ----
# 文件存储根目录（空字符串表示自动使用 backend/ 目录）
STORAGE_DIR=
# 摘要触发的历史长度阈值（历史消息超过此长度时触发摘要压缩）
SUMMARY_TRIGGER_HISTORY_LEN=10
# 反馈分析报告保留数量（清理旧报告时保留最近 N 个）
FEEDBACK_REPORT_KEEP_COUNT=12
# 业务指标采集循环间隔（秒）
METRICS_COLLECTOR_INTERVAL=60
# 对话摘要缓存 TTL（秒，3600 = 1 小时）
CHAT_SUMMARY_TTL=3600
# 通用缓存默认 TTL（秒，300 = 5 分钟）
CACHE_DEFAULT_TTL=300
# 流式生成取消标志 TTL（秒，300 = 5 分钟自动清理）
CHAT_CANCEL_TTL=300
# 文档处理进度缓存 TTL（秒，3600 = 1 小时）
DOC_PROGRESS_CACHE_TTL=3600

# ---- Task 3.6 新增配置 ----
# 用户信息缓存 TTL（秒）
USER_CACHE_TTL=60
# 优雅关闭超时（秒）
GRACEFUL_SHUTDOWN_TIMEOUT=30
# 内存黑名单上限（Redis 不可用降级时防无限增长）
TOKEN_BLACKLIST_MAX=10000
